# Fill these three variables before starting Compose.
POSTGRES_PASSWORD=
RAG_DB_PASSWORD=
RAG_CODE_VERSION=

# Compose uses this database for the API, worker and migration job.
RAG_DB_NAME=rag
API_HOST=127.0.0.1
API_PORT=8000
RAG_IMAGE=agentic-pdf-rag:local

# Ollama model tag and the model name exposed by the vLLM profile.
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Set the vLLM model and its full commit hash together to override the defaults.
VLLM_MODEL=
VLLM_MODEL_REVISION=
HF_TOKEN=

# The CPU Compose override forces offline mode.
RAG_OFFLINE=0
CORS_ORIGINS=
RAG_RETRIEVAL_STRATEGY=agentic
RAG_RERANKER_MIN_SCORE=
JOB_TIMEOUT_S=240
JOB_MEMORY_BYTES=8589934592
WORKER_EMBEDDING_BATCH_SIZE=8
